<div>
    <h1>Lista de Productos (Estática)</h1>
    <div class="product-list">
        {{#if products.length}}
            {{#each products}}
                <div class="product-card">
                    <h3>{{this.title}}</h3>
                    <p>{{this.description}}</p>
                    <p>Precio: ${{this.price}}</p>
                    <p>Código: {{this.code}}</p>
                </div>
            {{/each}}
        {{else}}
            <p>No hay productos para mostrar.</p>
        {{/if}}
    </div>